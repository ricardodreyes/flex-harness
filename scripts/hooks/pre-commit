#!/bin/sh
# Blocks staged secrets: private keys, certs, Anthropic keys, Mongo URIs with passwords, .env and .pem files.
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
if echo "$staged" | grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|\.p12$' | grep -v '\.env\.example$'; then
  echo "pre-commit: refusing to commit a secret file (above)." >&2; exit 1
fi
if git diff --cached -U0 -- $staged | grep -E '^\+' | grep -E -- '-----BEGIN [A-Z ]*(PRIVATE KEY|CERTIFICATE)-----|sk-ant-[A-Za-z0-9_-]{10,}|mongodb(\+srv)?://[^/@ ]+:[^/@ ]+@|rdk_[A-Za-z0-9]{16,}'; then
  echo "pre-commit: staged diff contains what looks like a secret (above)." >&2; exit 1
fi
